# Copy to .env and fill in values
# bun auto-loads .env — no dotenv needed

# Required for LLM-as-judge evals (bun run test:eval)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: enables `$B search` and Firecrawl-backed `$B fetch` (web search +
# clean URL→markdown). Without it, fetch falls back to the local browser and
# search is unavailable. Alternatives: `gstack-config set firecrawl_key fc-…`
# or `npx firecrawl-cli login --method browser` (browser sign-in).
FIRECRAWL_API_KEY=fc-your-key-here
